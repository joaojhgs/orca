[Unit]
Description=Private Unix-only Hermes manager connection to coding worker
After=network-online.target orca-manager-ipc-broker.service
Wants=network-online.target
Requires=orca-manager-ipc-broker.service
PartOf=orca-manager-ipc-broker.service

[Service]
Type=simple
User=orca
Group=orca
ExecStart=/usr/bin/ssh -F /dev/null -N -T -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/var/lib/orca-control/manager-transport/known_hosts -i /var/lib/orca-control/manager-transport/id_ed25519 -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -R /run/hermes-manager-transport/orca.sock:/run/orca-manager-broker/rpc.sock -R /run/hermes-manager-transport/metadata.sock:/run/orca-manager-broker/metadata.sock hermes-transport@10.0.2.123
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
MemoryMax=32M
MemorySwapMax=0
CPUQuota=10%
Nice=15
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.0.2.123/32

[Install]
WantedBy=multi-user.target
